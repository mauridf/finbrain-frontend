# URL base da API FinBrain (.NET 10)
# Local:      http://localhost:5100/api/v1
# Staging:    https://api-staging.finbrain.com.br/api/v1
# Produção:   https://api.finbrain.com.br/api/v1
VITE_API_BASE_URL=http://localhost:5100/api/v1

# Nome exibido (usado em <title>, toasts, headers)
VITE_APP_NAME=FinBrain

# Tempo máximo (ms) para requisições HTTP (não conta o SSE do Advisor)
VITE_API_TIMEOUT_MS=30000